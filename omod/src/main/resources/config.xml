<?xml version="1.0" encoding="UTF-8"?>

<module configVersion="1.2">

	<!-- Propiedades del modulo (se completan desde el pom.xml) -->
	<id>${project.parent.artifactId}</id>
	<name>${project.parent.name}</name>
	<version>${project.parent.version}</version>
	<package>${project.parent.groupId}.${project.parent.artifactId}</package>
	<author>${project.parent.organization.name}</author>
	<description>${project.parent.description}</description>
	<require_version>${openMRSVersion}</require_version>

	<require_modules>
		<require_module version="${webservices.restVersion}">
			org.openmrs.module.webservices.rest
		</require_module>
	</require_modules>

	<activator>${project.parent.groupId}.${project.parent.artifactId}.ProtocolosActivator</activator>

	<messages>
		<lang>en</lang>
		<file>messages.properties</file>
	</messages>

	<!-- Paquetes con entidades JPA (@Entity) que Hibernate tiene que mapear -->
	<packagesWithMappedClasses>org.openmrs.module.protocolos.model</packagesWithMappedClasses>
	<!-- Privilegios: OpenMRS los crea al iniciar el modulo -->
	<privilege>
		<name>Get Protocolos</name>
		<description>Permite ver y descargar los protocolos institucionales</description>
	</privilege>
	<privilege>
		<name>Manage Protocolos</name>
		<description>Permite subir, modificar y eliminar protocolos institucionales</description>
	</privilege>

</module>
