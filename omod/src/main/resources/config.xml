<?xml version="1.0" encoding="UTF-8"?>

<module configVersion="1.2">

	<!-- Propiedades del modulo (se completan desde el pom.xml) -->
	<id>${project.parent.artifactId}</id>
	<name>${project.parent.name}</name>
	<version>${project.parent.version}</version>
	<package>${project.parent.groupId}.${project.parent.artifactId}</package>
	<author>${project.parent.organization.name}</author>
	<description>${project.parent.description}</description>
	<require_version>${openMRSVersion}</require_version>

	<require_modules>
		<require_module version="${webservices.restVersion}">
			org.openmrs.module.webservices.rest
		</require_module>
	</require_modules>

	<activator>${project.parent.groupId}.${project.parent.artifactId}.ProtocolosActivator</activator>

	<messages>
		<lang>en</lang>
		<file>messages.properties</file>
	</messages>

	<!-- Paso 3: mappedClasses / packagesWithMappedClasses -->
	<!-- Paso 4: privilegios Get Protocolos y Manage Protocolos -->

</module>
