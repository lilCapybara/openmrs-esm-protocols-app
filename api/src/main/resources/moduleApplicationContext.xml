<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">

	<!-- DAO: usa la sesion de Hibernate de OpenMRS -->
	<bean id="protocolos.ProtocoloDao" class="org.openmrs.module.protocolos.api.db.hibernate.HibernateProtocoloDao">
		<property name="sessionFactory">
			<ref bean="dbSessionFactory" />
		</property>
	</bean>

	<!-- Servicio envuelto en transacciones y en los interceptores de OpenMRS
	     (que completan creator, dateCreated, voidedBy, etc. y validan @Authorized) -->
	<bean id="protocolos.ProtocoloService" class="org.springframework.transaction.interceptor.TransactionProxyFactoryBean">
		<property name="transactionManager">
			<ref bean="transactionManager" />
		</property>
		<property name="target">
			<bean class="org.openmrs.module.protocolos.api.impl.ProtocoloServiceImpl">
				<property name="dao">
					<ref bean="protocolos.ProtocoloDao" />
				</property>
			</bean>
		</property>
		<property name="preInterceptors">
			<ref bean="serviceInterceptors" />
		</property>
		<property name="transactionAttributeSource">
			<ref bean="transactionAttributeSource" />
		</property>
	</bean>

	<!-- Registra el servicio para Context.getService(ProtocoloService.class) -->
	<bean parent="serviceContext">
		<property name="moduleService">
			<list>
				<value>org.openmrs.module.protocolos.api.ProtocoloService</value>
				<ref bean="protocolos.ProtocoloService" />
			</list>
		</property>
	</bean>

</beans>
